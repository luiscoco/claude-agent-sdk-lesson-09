{
  "name": "claude-agent-sdk-lesson-09",
  "version": "1.0.0",
  "private": true,
  "description": "Lesson 9 Migration Workbench: API status inventory, staged migration plans, task-tool and permission verification, opt-in prewarm and settings inspection.",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js --production",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm test && npm run build",
    "api:check": "tsx src/examples/api-check.ts",
    "live:smoke": "tsx src/examples/live-smoke.ts",
    "settings:inspect": "tsx src/examples/settings-inspect.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7",
    "typescript-compiler": "npm:typescript@5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "vite": "8.3.5",
    "typescript": "7.0.2"
  }
}
